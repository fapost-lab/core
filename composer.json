{
    "name": "fapost/core",
    "type": "project",
    "description": "FaPost Core — an Apache-2.0 framework for conversational assistants, built on Laravel.",
    "keywords": [
        "fapost",
        "chatbot",
        "telegram",
        "whatsapp",
        "flow-automation"
    ],
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "FaPost Team"
        }
    ],
    "require": {
        "php": "^8.5",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "composer/semver": "^3.4",
        "fapost/foundation": "^0.34",
        "fapost/support": "^0.2",
        "giggsey/libphonenumber-for-php": "^9.0",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/framework": "^13.0",
        "laravel/horizon": "^5.45",
        "laravel/reverb": "^1.12",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.0",
        "romanzipp/laravel-queue-monitor": "^5.4",
        "spatie/laravel-activitylog": "^5.0",
        "spatie/laravel-data": "^4.20",
        "spatie/laravel-permission": "^8.3",
        "spatie/laravel-settings": "^3.9"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.7",
        "brianium/paratest": "^7.24",
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^2.0",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpat/phpat": "^0.12.4",
        "phpunit/phpunit": "^13.3",
        "spatie/laravel-ray": "^1.43"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fapost\\Testing\\": "testing/",
            "Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/fapost-lab/foundation.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/fapost-lab/support.git"
        }
    ],
    "scripts": {
        "hooks:install": "@php tools/git-hooks/install.php",
        "dev:link": "@php tools/dev-link-packages.php",
        "overlay": [
            "Composer\\Config::disableProcessTimeout",
            "@php tools/composer-overlay.php"
        ],
        "overlay:post-install": [
            "Composer\\Config::disableProcessTimeout",
            "@php tools/composer-overlay.php --post-install-only"
        ],
        "ngrok": "tools/ngrok-http",
        "tunnel": "tools/cf-tunnel",
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm ci",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan horizon\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,horizon,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test --parallel"
        ],
        "test:redis": [
            "@php artisan config:clear --ansi",
            "@php artisan test --group=redis"
        ],
        "test:arch": [
            "vendor/bin/phpstan analyse --configuration phpstan.neon --memory-limit=512M --no-interaction"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-install-cmd": [
            "@hooks:install",
            "@dev:link"
        ],
        "post-update-cmd": [
            "@hooks:install",
            "@dev:link",
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi",
            "@php artisan ide-helper:generate --ansi",
            "@php artisan ide-helper:meta --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "docs:build": "php tools/doctum/doctum.phar update tools/doctum/config.php --ignore-parse-errors"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
