{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "fapost/core",
  "type": "project",
  "description": "FAPost Core — platform for building conversational bots in Telegram and WhatsApp.",
  "keywords": [
    "fapost",
    "chatbot",
    "telegram",
    "whatsapp",
    "flow-automation"
  ],
  "license": "proprietary",
  "authors": [
    {
      "name": "FAPost Team"
    }
  ],
  "require": {
    "php": "^8.4",
    "filament/filament": "^5.0",
    "irazasyed/telegram-bot-sdk": "^3.15",
    "laravel/framework": "^12.0",
    "laravel/horizon": "^5.45",
    "laravel/octane": "^2.17",
    "laravel/tinker": "^3.0",
    "romanzipp/laravel-queue-monitor": "^5.4",
    "spatie/laravel-activitylog": "^4.12",
    "spatie/laravel-data": "^4.20",
    "spatie/laravel-model-states": "^2.13",
    "spatie/laravel-query-builder": "^7.0",
    "spatie/laravel-settings": "^3.7",
    "spiral/roadrunner-cli": "^2.6.0",
    "spiral/roadrunner-http": "^3.3.0",
    "tpetry/laravel-postgresql-enhanced": "^3.6"
  },
  "require-dev": {
    "barryvdh/laravel-ide-helper": "^3.7",
    "fakerphp/faker": "^1.23",
    "laravel/boost": "^2.0",
    "laravel/pail": "^1.2.5",
    "laravel/pint": "^1.27",
    "laravel/telescope": "^5.0",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.6",
    "phpat/phpat": "^0.12.4",
    "phpunit/phpunit": "^12.5.12",
    "spatie/laravel-ray": "^1.43"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "setup": [
      "composer install",
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
      "@php artisan key:generate",
      "@php artisan migrate --force",
      "npm install",
      "npm run build"
    ],
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan horizon\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,horizon,logs,vite --kill-others"
    ],
    "test": [
      "@php artisan config:clear --ansi",
      "@php artisan test"
    ],
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi",
      "@php artisan filament:upgrade"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
      "@php artisan boost:update --ansi",
      "@php artisan ide-helper:generate --ansi",
      "@php artisan ide-helper:meta --ansi"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi",
      "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
      "@php artisan migrate --graceful --ansi"
    ],
    "pre-package-uninstall": [
      "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": [
        "laravel/telescope"
      ]
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
