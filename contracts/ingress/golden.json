            },
            "secret": "channel-secret",
            "channelId": "channel-42",
            "request": {
                "rawBody": "{\"n\":9223372036854775807}",
                "headers": {},
                "query": {}
            },
            "expect": {
                "verified": true,
                "idempotencyKey": "9223372036854775807"
            },
            "note": "Must not go through a float: that would round to 9223372036854775808."
        },
