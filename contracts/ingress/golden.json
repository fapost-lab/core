        {
            "name": "hmac_sha256: signature over unmodified bytes",
            "spec": {
                "prefix": "",
                "v": 1,
                "scheme": "hmac_sha256",
                "parameter": "x-hub-signature-256",
                "idempotency": "wa:{channel}:{body.update_id}"
            },
            "secret": "channel-secret",
            "channelId": "channel-42",
            "request": {
                "rawBody": "{\"b\":2,\"a\":1,\"text\":\"café\"}",
                "headers": {
                    "x-hub-signature-256": "ae541b0f2cfaeb2476dbbc9aa9dbbbaa5e778adcfebafd8d7eed653cef22e3a4"
                },
                "query": {}
            },
            "expect": {
                "verified": true,
                "idempotencyKey": "wa:channel-42:"
            },
            "note": "Body must be signed as received. Decoding and re-encoding reorders keys and escapes non-ASCII, which changes the digest."
        },
        {
            "name": "hmac_sha256: signature over re-encoded bytes must fail",
            "spec": {
                "prefix": "",
                "v": 1,
                "scheme": "hmac_sha256",
                "parameter": "x-hub-signature-256",
                "idempotency": "wa:{channel}:{body.update_id}"
            },
            "secret": "channel-secret",
            "channelId": "channel-42",
            "request": {
                "rawBody": "{\"b\":2,\"a\":1,\"text\":\"café\"}",
                "headers": {
                    "x-hub-signature-256": "66897d3831313832eacb7eb849bc90557db2cf41a1d457d01008b5c3804e49d6"
                },
                "query": {}
            },
            "expect": {
                "verified": false,
                "idempotencyKey": "wa:channel-42:"
            },
            "note": "Guards the round-trip mistake explicitly: this digest is valid for the re-encoded body and must still be rejected."
        },
