{
    "version": 1,
    "description": "Golden cases for IngressSpec execution. Every ingress runtime must produce these verdicts and keys exactly.",
    "cases": [
        {
            "name": "header_equals: exact match",
            "spec": {
                "v": 1,
                "scheme": "header_equals",
                "parameter": "x-telegram-bot-api-secret-token",
                "prefix": "",
                "idempotency": "tg:{channel}:{body.update_id}"
            },
            "secret": "channel-secret",
            "channelId": "channel-42",
            "request": {
                "rawBody": "{\"update_id\":987654,\"message\":{\"chat\":{\"id\":5},\"text\":\"hi\"}}",
                "headers": {
                    "x-telegram-bot-api-secret-token": "channel-secret"
                },
                "query": {}
            },
            "expect": {
                "verified": true,
                "idempotencyKey": "tg:channel-42:987654"
            }
        },
        {
            "name": "header_equals: header name is case insensitive",
            "spec": {
                "v": 1,
                "scheme": "header_equals",
                "parameter": "x-telegram-bot-api-secret-token",
                "prefix": "",
                "idempotency": "tg:{channel}:{body.update_id}"
            },
            "secret": "channel-secret",
            "channelId": "channel-42",
            "request": {
                "rawBody": "{\"update_id\":987654,\"message\":{\"chat\":{\"id\":5},\"text\":\"hi\"}}",
                "headers": {
                    "X-Telegram-Bot-Api-Secret-Token": "channel-secret"
                },
                "query": {}
            },
            "expect": {
                "verified": true,
                "idempotencyKey": "tg:channel-42:987654"
            },
            "note": "Header lookup must be case insensitive in every runtime."
        },
        {
            "name": "header_equals: wrong secret",
            "spec": {
                "v": 1,
                "scheme": "header_equals",
                "parameter": "x-telegram-bot-api-secret-token",
