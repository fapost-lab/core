{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "lib": ["ESNext", "DOM"],
    "types": ["vite/client"],
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@builder/*": ["./resources/js/builder/*"],
      "@console/*": ["./resources/js/console/*"],
      "@shared/*": ["./resources/js/shared/*"],
      "@tma/*": ["./resources/js/tma/*"],
      "vue": ["./node_modules/vue"],
      "@inertiajs/vue3": ["./node_modules/@inertiajs/vue3"],
      "reka-ui": ["./node_modules/reka-ui"],
      "vue-sonner": ["./node_modules/vue-sonner"]
    }
  },
  "include": ["resources/js/**/*"],
  "exclude": ["node_modules", "public"]
}
