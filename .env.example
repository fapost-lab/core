APP_NAME=FaPost-CORE
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
TENANCY_BASE_DOMAIN=localhost
# How a request finds its tenant: single | host.
# single - one tenant per deployment, taken from TENANT_SLUG (the default).
# host   - the tenant is named by the request host, <slug>.<TENANCY_BASE_DOMAIN>;
#          the base domain itself serves platform pages with no tenant.
TENANCY_RESOLUTION=single
# Lets an operator package enter a tenant as its platform support user. Off unless the package asks for it.
SUPPORT_ACCESS_ENABLED=false
WEBHOOK_BASE_URL="${APP_URL}"

# Read by docker/compose.yaml, not by the application. Compose interpolates the
# whole file before it knows which profiles are active, so the TLS service's
# variables have to be present even though `make dev` never starts it — leaving
# them blank stops a plain development `up`. See .env.production.example for the
# values a server actually wants.
APP_DOMAIN=localhost
ACME_EMAIL=dev@localhost

# Ingress runtime for newly registered channels: laravel | gateway.
# The Laravel route always stays live, so switching only affects channels
# registered from that point on; use ops:ingress-migrate to move the rest.
WEBHOOK_INGRESS_DRIVER=laravel
WEBHOOK_GATEWAY_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# These are what the Docker development stack creates its database with, so
# `cd docker && make dev` works from this file unedited. DB_HOST and DB_PORT are
# overridden by compose to the service name; they are here for a local install,
# which is also where these credentials have to be changed to match a PostgreSQL
# you provisioned yourself.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=fapost_core
DB_USERNAME=fapost
DB_PASSWORD=secret

# Landlord defaults to the DB_* values above. LANDLORD_DB_* is advanced and not supported for
# now: a separate landlord database leaves root tables (cache, jobs, failed_jobs, telescope)
# where nothing reads them. Tenant schemas are created on TENANT_DB_CONNECTION (default pgsql).
# LANDLORD_DB_HOST=
# LANDLORD_DB_PORT=
# LANDLORD_DB_DATABASE=
# LANDLORD_DB_USERNAME=
# LANDLORD_DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Addresses allowed to vouch for the client IP behind a reverse proxy (comma-separated addresses or CIDRs, or *).
# Empty trusts nobody: fine locally, wrong behind Caddy or a load balancer.
# TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

# Same as the database: this is the password compose starts Redis with. It has
# to be a real one — the container is launched with `--requirepass`, and the
# literal `null` Laravel reads as "no password" would be a password to Redis.
# Against a local Redis with no `requirepass`, set it back to `null`.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=secret
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"


TELESCOPE_ENABLED=true

HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001
HCAPTCHA_SECRET_KEY=0x0000000000000000000000000000000000000000

# Keep the conversation transcript this many days (whole months are dropped, so up to ~31 days longer).
# Unset = keep forever. A plain whole number of days; anything else disables pruning. WARNING: pruning drops data partitions and is irreversible.
# CONVERSATION_RETENTION_DAYS=365
