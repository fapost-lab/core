#!/usr/bin/env bash
#
# Expose the local site over HTTPS so a provider can deliver webhooks to it.
#
# Two modes:
#
#   cf-tunnel fapost-core          quick tunnel — a throwaway *.trycloudflare.com
#                                  hostname, no account, no setup
#
#   cf-tunnel fapost-core dev.example.com
#                                  named tunnel — a stable hostname on a zone you
#                                  control, which survives restarts
#
# The local host is a vhost name rather than a port, so the Host header has to be
# rewritten on the way in: the web server picks the site by that header, and the
# tunnel would otherwise send the public hostname.

set -euo pipefail

local_domain="${1:-}"
public_hostname="${2:-}"

if [[ -z "${local_domain}" ]]; then
    echo "Usage: $(basename "$0") <local-domain> [public-hostname]" >&2
    echo >&2
    echo "  $(basename "$0") fapost-core                    quick tunnel" >&2
    echo "  $(basename "$0") fapost-core dev.example.com    named tunnel" >&2
    exit 1
fi

if [[ "${local_domain}" == *.* ]]; then
    local_host="${local_domain}"
else
    local_host="${local_domain}.test"
fi

cloudflared_bin="${CLOUDFLARED_BIN:-cloudflared}"
local_port="${CF_TUNNEL_PORT:-80}"
tunnel_name="${CF_TUNNEL_NAME:-${local_domain}}"

if ! command -v "${cloudflared_bin}" >/dev/null 2>&1; then
    echo "cloudflared not found. Install it with: brew install cloudflared" >&2
    exit 1
fi

if [[ -z "${public_hostname}" ]]; then
    echo "Quick tunnel to http://${local_host}:${local_port}"
    echo "The hostname is printed below and changes on every run."
    echo
    exec "${cloudflared_bin}" tunnel \
        --url "http://127.0.0.1:${local_port}" \
        --http-host-header "${local_host}"
fi

# Named tunnel. Created once, then reused; the DNS record points the hostname at
# this tunnel's id, so the address stays the same across restarts.
if ! "${cloudflared_bin}" tunnel info "${tunnel_name}" >/dev/null 2>&1; then
    echo "Creating tunnel ${tunnel_name}"
    "${cloudflared_bin}" tunnel create "${tunnel_name}"
    "${cloudflared_bin}" tunnel route dns "${tunnel_name}" "${public_hostname}"
fi

echo "Tunnel ${tunnel_name}: https://${public_hostname} -> http://${local_host}:${local_port}"
echo

exec "${cloudflared_bin}" tunnel run \
    --url "http://127.0.0.1:${local_port}" \
    --http-host-header "${local_host}" \
    "${tunnel_name}"
