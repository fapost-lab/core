includes:
	- vendor/phpat/phpat/extension.neon

# PHPat discovers rules ONLY through services tagged `phpat.test` — a class in
# tests/Architecture that is not listed here is never executed. Register every
# new architecture test class below.
services:
	-
		class: Tests\Architecture\CountableModelCreationTest
		tags:
			- phpat.test
	-
		class: Tests\Architecture\CurrentAssistantSourceTest
		tags:
			- phpat.test
	-
		class: Tests\Architecture\FlowRuntimeIsolationTest
		tags:
			- phpat.test
	-
		class: Tests\Architecture\HandlerVersionContractTest
		tags:
			- phpat.test
	-
		class: Tests\Architecture\IdStrategyTest
		tags:
			- phpat.test
	-
		class: Tests\Architecture\MessagingBoundariesTest
		tags:
			- phpat.test
	-
		class: Tests\Architecture\MigrationTest
		tags:
			- phpat.test

parameters:
	level: 0
	paths:
		- app
		- database
		- tests/Architecture

	ignoreErrors:
		# laravel/framework 12.68 annotates the Redis facade as
		# `@method static void keys(string $pattern)`. The command returns the
		# matching keys — the annotation is wrong, not the call. Compare `get`
		# and `del` in the same docblock, which are typed correctly.
		# Remove this once the upstream annotation is fixed.
		-
			message: '#^Result of static method Illuminate\\Support\\Facades\\Redis\:\:keys\(\) \(void\) is used\.$#'
			path: app/Domains/Tenancy/Services/WebhookRegistryHealthChecker.php
