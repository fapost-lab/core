# FaPost Core — production environment.
#
# Serves both installation paths. In containers, copy it to .env beside
# compose.yaml; on bare metal, to the project root — `deploy/install.sh` does
# that for you and then hands over to `php artisan install`, which fills in the
# connection settings after verifying them.
#
# Fill in the four values marked REQUIRED. Everything else has a working default.
#
# This file is not .env.example: that one is the development configuration, and
# its values — APP_ENV=local, an empty database password, Telescope on — are all
# wrong here. Production images are built with --no-dev, so packages registered
# for the local environment are not in them at all.

# ─── Identity ────────────────────────────────────────────────────────────────

APP_NAME=FaPost
APP_ENV=production
APP_DEBUG=false

# REQUIRED. Generate one before the first start; the application refuses to boot
# without it, and changing it later invalidates every session and encrypted value:
#
#     APP_KEY=base64:$(openssl rand -base64 32)
APP_KEY=

# ─── Hostnames ───────────────────────────────────────────────────────────────
#
# There are two of them, and the difference is the single most common way to get
# a broken install:
#
#   APP_URL / TENANCY_BASE_DOMAIN   the base domain. Serves the welcome page and
#                                   is reserved for a control plane.
#   TENANT_SLUG + the base domain   the tenant's own host — where the admin panel
#                                   and the assistant console actually live.
#
# With the values below the panel is at https://app.fapost.example.com/admin,
# not at the base domain. Both names must resolve to this host, and both need a
# certificate — the tls profile issues one for each.

# REQUIRED.
APP_URL=https://fapost.example.com
TENANCY_BASE_DOMAIN=fapost.example.com
TENANT_SLUG=app

# How a request finds its tenant: single | host.
#   single  one tenant, served on every host. TENANT_SLUG names it.
#   host    one tenant per <slug>.TENANCY_BASE_DOMAIN host, any number of them. Needs a
#           wildcard DNS record and certificate (see "Several tenants" in the self-hosting
#           guide), a session driver that is not `database`, and SESSION_DOMAIN unset.
#           WEBHOOK_BASE_URL and the gateway host must sit under TENANCY_BASE_DOMAIN.
# Changing it needs the route cache rebuilt; the container entrypoint does that on start.
TENANCY_RESOLUTION=single

WEBHOOK_BASE_URL="${APP_URL}"

# Ingress runtime for newly registered channels: laravel | gateway.
# The Laravel route always stays live, so switching only affects channels
# registered from that point on; use ops:ingress-migrate to move the rest.
WEBHOOK_INGRESS_DRIVER=laravel
WEBHOOK_GATEWAY_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# ─── Database ────────────────────────────────────────────────────────────────
#
# The host and port matter on bare metal and are ignored in containers: compose
# sets both to its own service names through `environment:`, which takes
# precedence over this file. They are stated anyway, because leaving them out
# only helps the container case and leaves the other one guessing.

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=fapost
DB_USERNAME=fapost

# REQUIRED. Postgres refuses to start without one, so compose fails up front
# rather than half-starting the stack:
#
#     DB_PASSWORD=$(openssl rand -hex 24)
DB_PASSWORD=

# ─── Redis ───────────────────────────────────────────────────────────────────
#
# Queues, cache, locks and the webhook routing registry. Host and port are
# likewise replaced by compose and likewise needed without it.

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# REQUIRED, same as above.
REDIS_PASSWORD=

# Namespaces every key. Set it if this Redis is shared with anything else.
REDIS_PREFIX=fapost:
REDIS_DB=0

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Keep this unset (null). Host tenancy mode needs cookies bound to the exact host:
# a domain such as .fapost.example.com would send one tenant's session to every other.
SESSION_DOMAIN=null

# Addresses allowed to vouch for the client IP through X-Forwarded-For: comma-separated
# addresses or CIDR ranges, or `*` (anyone who connects directly; only if nothing else can
# reach the application). Left commented out, the bundled Compose file trusts only its own
# Caddy, at the fixed address it gives it (CADDY_ADDRESS, 172.30.0.2 in COMPOSE_SUBNET
# 172.30.0.0/24, outside the dynamic COMPOSE_IP_RANGE 172.30.0.128/25; change all three
# together if that range is taken on your host or by a second installation). Do NOT set it to an
# empty value to "reset" it: empty means trust no proxy, and every client then appears
# with the proxy's address. Behind Cloudflare, list its published ranges next to Caddy's
# address. Compose reads this from the .env beside compose.yaml, not from ENV_FILE.
# TRUSTED_PROXIES=172.30.0.2

FILESYSTEM_DISK=local

# ─── Live updates ────────────────────────────────────────────────────────────
#
# `null` broadcasts nothing and the console polls every few seconds — the default,
# and nothing else is needed. For websocket updates start the `realtime` compose
# profile and set `reverb` with three keys of your own (any random strings; the key
# reaches browsers, the secret never does). Compose points the application at the
# reverb service and nginx forwards browsers to it at /app/ on the site's own
# origin, so nothing else is needed. See the "Realtime" self-hosting page.
BROADCAST_CONNECTION=null
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# Where browsers connect, only when that is not the site itself.
# BROADCAST_CLIENT_HOST=
# BROADCAST_CLIENT_PORT=
# BROADCAST_CLIENT_SCHEME=

# ─── Logging ─────────────────────────────────────────────────────────────────
#
# stderr rather than a file, on both paths: the runtime already collects it —
# Docker for containers, journald for the systemd units on bare metal — and a
# log file the application writes itself is one nobody rotates and nobody reads.

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

BCRYPT_ROUNDS=12
APP_MAINTENANCE_DRIVER=file

# ─── Mail ────────────────────────────────────────────────────────────────────
#
# `log` writes messages to the log instead of sending them. Fine until the first
# password reset — point this at a real transport before staff need one.

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="fapost@fapost.example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Compose ─────────────────────────────────────────────────────────────────
#
# Everything below is read by docker/compose.yaml, not by the application. On
# bare metal it is inert — harmless to leave, and there is no equivalent to set:
# ports, images and TLS are the web server's and the supervisor's business there.

# Image source. Pin APP_VERSION to a release tag in production: `latest` moves,
# and an unplanned upgrade is what a restart then becomes.
REGISTRY=ghcr.io/fapost-lab
APP_VERSION=latest
GATEWAY_VERSION=latest

# Where the web service publishes plain HTTP. With the tls profile on, bind it to
# the loopback: otherwise this port is a way around Caddy and its certificate.
HTTP_PORT=8000
HTTP_BIND=0.0.0.0

# ─── TLS (compose profile: tls) ──────────────────────────────────────────────
#
# Used only when this host terminates TLS itself. If Traefik, nginx or a cloud
# load balancer already does, leave the profile off and point it at the web
# service — but still fill both values in: Compose interpolates the whole file
# before it knows which profiles are active, so an empty one stops a plain HTTP
# start as well.
#
# APP_DOMAIN must equal TENANCY_BASE_DOMAIN — the tenant host is derived from it
# and TENANT_SLUG, so a mismatch means a certificate for a name nothing answers on.

APP_DOMAIN=fapost.example.com
ACME_EMAIL=ops@fapost.example.com

# Host tenancy mode only. The wildcard site and its certificate come from the DNS
# challenge, which needs a Caddy image with a module for your DNS provider, and a
# `*.caddy` file in CADDY_SITES_DIR that declares the site. Both are optional otherwise.
# CADDY_IMAGE=registry.example.com/caddy-cloudflare:2
# CADDY_SITES_DIR=./caddy.d

# ─── Webhook gateway (compose profile: gateway) ──────────────────────────────
#
# Optional Go ingress in front of PHP. Leave GATEWAY_DOMAIN empty unless the
# gateway is deployed on a subdomain of its own.

GATEWAY_DOMAIN=
GATEWAY_PORT=8080
GATEWAY_BIND=0.0.0.0
GATEWAY_LOG_LEVEL=info

# Only a proxy listed here may set X-Forwarded-For; from anyone else the header
# is ignored, or a caller could forge a client address and walk past the rate
# limit. Set it to whatever terminates TLS.
#
# Entries are exact addresses or CIDR ranges, comma-separated — not hostnames.
# On a compose network the proxy's address is assigned by Docker and changes
# when the container is recreated, so trust the subnet rather than an address:
#
#   GATEWAY_TRUSTED_PROXIES=172.16.0.0/12
#
# The gateway refuses to start on an entry it cannot parse.
GATEWAY_TRUSTED_PROXIES=
